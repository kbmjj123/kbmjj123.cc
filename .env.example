# AI Image Generation (scripts/gen-image.mjs)
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://ai.xmiaom.com/v1
AI_IMAGE_MODEL=gpt-image-2-4k

# R2 图片存储（用于 migrate-images-to-r2.ts）
# Cloudflare Dashboard → R2 → Manage R2 API Tokens → Create API Token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aifindr-media
R2_PUBLIC_URL=https://r2.aifindr.org
